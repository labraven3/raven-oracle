# Raven Oracle local environment template
# Copy to .env for local development. Never commit real secrets.

# IMPORTANT SECURITY RULES:
# - JWT_SECRET must be at least 32 characters (64+ recommended for production)
# - DATABASE_URL is required in production
# - Never use example/placeholder values in production
# - Use cryptographically random secrets
# - Generate secure secrets: openssl rand -base64 48

# PostgreSQL (REQUIRED)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/raven_oracle"

# Backend
PORT=4000
WEB_ORIGIN="http://localhost:3000"

# JWT Authentication Secret (REQUIRED)
# MUST be at least 32 characters, 64+ characters recommended for production
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# X OAuth 2.0 (OPTIONAL)
X_CLIENT_ID="replace-with-x-client-id"
X_CLIENT_SECRET="replace-with-x-client-secret"
X_REDIRECT_URI="http://localhost:4000/api/auth/x/callback"

# Discord OAuth 2.0 (OPTIONAL)
DISCORD_CLIENT_ID="replace-with-discord-client-id"
DISCORD_CLIENT_SECRET="replace-with-discord-client-secret"
DISCORD_REDIRECT_URI="http://localhost:4000/api/auth/discord/callback"
