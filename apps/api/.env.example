# Raven Oracle API local/production environment template
# Copy to apps/api/.env and replace placeholders with real values.
# Never commit a real .env file.

# IMPORTANT SECURITY RULES:
# - JWT_SECRET must be at least 32 characters (64+ recommended for production)
# - DATABASE_URL is required in production
# - Never use example/placeholder values in production
# - Use cryptographically random secrets (not dictionary words or patterns)
# - Never commit real secrets to Git

NODE_ENV=development
PORT=4000
WEB_ORIGIN="http://localhost:3000"

# PostgreSQL (REQUIRED)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/raven_oracle"

# JWT Authentication Secret (REQUIRED)
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Google Sheets legacy service-account fallback (OPTIONAL)
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Google Drive OAuth for creator-owned winner exports (OPTIONAL - new flow)
# Create a Web application OAuth client in Google Cloud.
# Callback must exactly match the deployed API URL:
# https://YOUR-API-HOST/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"

# X / X OAuth 2.0 (OPTIONAL - only required if X OAuth is enabled)
X_CLIENT_ID="replace-with-x-client-id"
X_CLIENT_SECRET="replace-with-x-client-secret"
X_REDIRECT_URI="http://localhost:4000/api/auth/x/callback"

# Discord OAuth 2.0 (OPTIONAL - only required if Discord OAuth is enabled)
DISCORD_CLIENT_ID="replace-with-discord-client-id"
DISCORD_CLIENT_SECRET="replace-with-discord-client-secret"
DISCORD_REDIRECT_URI="http://localhost:4000/api/auth/discord/callback"

# Telegram Bot (OPTIONAL - required only for Telegram account connection)
TELEGRAM_BOT_TOKEN="replace-with-telegram-bot-token"
TELEGRAM_BOT_USERNAME="your_raven_bot"
TELEGRAM_WEBHOOK_SECRET="replace-with-random-webhook-secret"

# Gmail SMTP (OPTIONAL - required only for email functionality)
GMAIL_USER="your-raven-oracle@gmail.com"
GMAIL_APP_PASSWORD="16-character-google-app-password"
EMAIL_FROM_NAME="Raven Oracle"
