# Raven Oracle Web Frontend Environment Variables

# Browser API base. Keep this same-origin in production.
NEXT_PUBLIC_API_URL="/api"

# Server-side API target used by the Next.js /api/* route handler.
# Default: http://127.0.0.1:4000
# Set this only when the Express API runs somewhere else.
API_URL="http://127.0.0.1:4000"
