# Raven Oracle Web Frontend Environment Variables

# API Base URL - Controls how frontend reaches backend API
# Default: "/api" (same-origin relative path, recommended)
# 
# Architecture:
# Browser → /api/* → Next.js rewrites → Express API (localhost:4000)
# 
# The frontend uses same-origin /api requests that Next.js automatically
# proxies to the Express API server on localhost:4000 (see next.config.ts).
# This avoids CORS issues and connection errors in production.
# 
# For local development: omit this variable (uses default "/api")
# For production deployment: omit this variable (uses default "/api")
# For custom API domain: set to full URL (e.g., "https://api.example.com/api")
NEXT_PUBLIC_API_URL="/api"
